{
  "name": "starter",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:raw": "WORKER_MODE=external turbo dev",
    "build": "turbo build",
    "test": "turbo run test",
    "check-types": "turbo check-types && pnpm check-types:scripts",
    "check-types:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "biome lint . && pnpm policy:prisma-query-casts && pnpm lint:design",
    "lint:design": "oxlint",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm policy:prisma-query-casts",
    "check:ci": "biome check . && pnpm policy:prisma-query-casts && pnpm policy:prisma-query-casts:test && pnpm lint:design",
    "verify": "pnpm check:ci && pnpm policy:checks && pnpm policy:template-secrets && pnpm policy:local-db-guard && pnpm policy:db-applier-state && pnpm policy:backup-writer && pnpm policy:agents-size && pnpm policy:test-colocation && pnpm policy:queue-wiring && pnpm policy:access-matrix && pnpm policy:schema-diff && pnpm check-types && pnpm test && pnpm test:setup && pnpm knip && pnpm env:check && pnpm env:check-entrypoints && pnpm docker:check-copy && pnpm docs:check-citations && pnpm deps:check-excludes",
    "verify:fast": "pnpm biome check . && pnpm deps:check-excludes && pnpm policy:prisma-query-casts && pnpm lint:design && pnpm policy:agents-size && pnpm policy:test-colocation && pnpm policy:queue-wiring && pnpm policy:access-matrix && pnpm docs:check-citations && pnpm env:check && pnpm policy:checks && pnpm turbo check-types --affected --output-logs=errors-only && pnpm check-types:scripts && pnpm turbo run test --affected --output-logs=errors-only && pnpm test:setup",
    "verify:tooling": "pnpm policy:checks:self-test && pnpm policy:hooks && pnpm policy:trufflehog-filter && pnpm policy:access-matrix:self-test && pnpm policy:schema-diff:self-test && pnpm dokploy:test && pnpm template:remove:test",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:worker": "turbo -F worker dev",
    "dev:native": "pnpm doctor:native && turbo -F native dev",
    "native:android": "pnpm doctor:native && turbo -F native android",
    "native:ios": "pnpm doctor:native && turbo -F native ios",
    "native:web": "pnpm doctor:native && turbo -F native web",
    "db:push": "turbo -F @starter/db db:push",
    "db:push:dangerous": "turbo -F @starter/db db:push:dangerous",
    "db:seed": "turbo -F @starter/db db:seed",
    "db:studio": "turbo -F @starter/db db:studio",
    "db:fingerprint": "bash scripts/schema-fingerprint.sh",
    "db:test-operations": "node scripts/test-schema-operations.mjs --disposable-postgres",
    "runtime:test-operations": "node scripts/test-runtime-operations.mjs --disposable-services",
    "dokploy:config": "node --import tsx scripts/generate-dokploy-config.ts",
    "dokploy:verify": "node scripts/verify-dokploy-deployment.mjs",
    "dokploy:test": "node scripts/test-dokploy-deployment.mjs && node --import tsx scripts/generate-dokploy-config.test.ts",
    "template:remove": "node scripts/remove-template-module.mjs",
    "template:remove:test": "node --test scripts/remove-template-module.test.mjs",
    "db:generate": "turbo -F @starter/db db:generate",
    "db:validate": "turbo -F @starter/db db:validate",
    "dev:services": "bash scripts/compose.sh -f docker-compose.dev.yml up -d",
    "dev:services:stop": "bash scripts/compose.sh -f docker-compose.dev.yml down",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "dev:tunnel:down": "bash scripts/dev-tunnel.sh down",
    "dev:docker": "bash scripts/dev-docker.sh",
    "dev:docker:logs": "bash scripts/dev-docker-logs.sh",
    "dev:docker:down": "bash scripts/dev-docker-down.sh",
    "find-free-port": "bash scripts/find-free-port.sh",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "generate:vapid": "pnpm -F @starter/api exec web-push generate-vapid-keys",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "env:sync": "tsx scripts/sync-env-example.ts",
    "env:check": "tsx scripts/sync-env-example.ts --check",
    "env:check-entrypoints": "tsx scripts/check-load-dotenv-contract.ts",
    "docker:check-copy": "node --import tsx scripts/check-docker-copy.ts --self-test && node --import tsx scripts/check-docker-copy.ts",
    "deps:check-excludes": "tsx scripts/check-release-age-excludes.ts",
    "docs:check-citations": "tsx scripts/check-doc-citations.ts",
    "policy:prisma-query-casts": "node scripts/check-prisma-query-cast-policy.ts --scan",
    "policy:prisma-query-casts:test": "node scripts/test-prisma-query-cast-policy.ts",
    "policy:checks": "bash scripts/policy-checks.sh",
    "policy:checks:self-test": "bash scripts/policy-checks.sh --self-test",
    "policy:hooks": "node scripts/claude-hooks/pre-tool-use.mjs --self-test && tsx scripts/test-install-claude-hooks.ts",
    "policy:trufflehog-filter": "node scripts/filter-trufflehog-results.mjs --cli-test",
    "policy:template-secrets": "node scripts/check-template-secret-patterns.mjs --self-test && node scripts/check-template-secret-patterns.mjs",
    "policy:local-db-guard": "bash scripts/assert-local-database.sh --self-test",
    "policy:db-applier-state": "node --test scripts/apply-schema.test.mjs scripts/lib/schema-diff.test.mjs scripts/restore-archive.test.mjs scripts/lib/bounded-child.test.mjs",
    "policy:backup-writer": "node --test scripts/test-backup-writer.mjs",
    "claude:hooks:install": "tsx scripts/install-claude-hooks.ts",
    "policy:test-colocation": "node scripts/check-test-colocation.ts",
    "policy:queue-wiring": "node scripts/check-queue-wiring.ts",
    "policy:schema-diff": "node scripts/check-schema-destructive-diff.ts",
    "policy:schema-diff:self-test": "node scripts/check-schema-destructive-diff.ts --self-test",
    "policy:agents-size": "node scripts/check-agents-size.ts",
    "policy:access-matrix": "node scripts/check-access-matrix.ts",
    "policy:access-matrix:self-test": "node scripts/check-access-matrix.ts --self-test",
    "setup": "tsx scripts/setup.ts",
    "test:setup": "node --import tsx --test scripts/lib/admin-email-env.test.ts scripts/lib/smtp-env.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:native": "tsx scripts/native-doctor.ts",
    "doctor:react": "react-doctor . --offline -y",
    "doctor:react:diff": "react-doctor . --scope changed --base \"$(git show-ref --verify --quiet refs/remotes/origin/main && echo origin/main || echo origin/master)\" --offline -y",
    "knip": "knip",
    "knip:production": "knip --production",
    "sync:agent-docs": "tsx scripts/sync-agent-docs.ts",
    "theme:apply": "tsx scripts/theme-apply.ts",
    "theme:reskin": "tsx scripts/theme-reskin.ts",
    "i18n:translate": "tsx scripts/translate-locale-bundles.ts",
    "i18n:translate:mailer": "tsx scripts/translate-locale-bundles.ts --source-dir packages/mailer/src/locales/en-US --target-dir packages/mailer/src/locales/es-MX",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@starter/env": "workspace:*",
    "@starter/i18n-translate": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@biomejs/biome": "^2.5.15",
    "@inquirer/prompts": "^8.7.2",
    "@shadcn/lint": "0.2.0",
    "@starter/config": "workspace:*",
    "@types/node": "catalog:",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxlint": "^1.86.0",
    "pg": "catalog:",
    "react-doctor": "^0.9.14",
    "tree-sitter-bash": "0.25.1",
    "tsx": "catalog:",
    "turbo": "^2.11.6",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-tree-sitter": "0.27.0"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.28.3+sha512.d49760a13b1755948775a5d4cb1bc4ba871ff2dc941adf851630d044ed722f9b5be8be57bef93166098c80c706bd612c282d05526dd1d0ae660188c086820f35"
}
