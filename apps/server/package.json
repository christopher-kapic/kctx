{
  "name": "server",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@starter/api": "workspace:*",
    "@starter/auth": "workspace:*",
    "@starter/db": "workspace:*",
    "@starter/env": "workspace:*",
    "@starter/queue": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "rate-limiter-flexible": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:",
    "worker": "workspace:*"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  }
}
