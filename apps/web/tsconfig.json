{
  "extends": "@starter/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "rootDirs": ["."],
    "paths": {
      "@/*": ["./src/*"],
      "@locales/*": ["../../packages/locales/src/*"],
      "@starter/ui/*": ["../../packages/ui/src/*"]
