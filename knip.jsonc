{
  "$schema": "https://unpkg.com/knip@latest/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        // Invoked by scripts/backup.sh via `node`, not statically imported.
        // Knip can't trace shell-script entry points, so declare it here.
        "scripts/upload-backup-to-s3.mjs!",
        "scripts/backup-heartbeat.mjs!",
        "scripts/download-backup-from-s3.mjs!",
        "scripts/write-db-applier-env.mjs!",
        // Spawned by the shared apply/follower comparison collector.
        "scripts/lib/prisma-diff-owner.mjs!",
        "scripts/trufflehog-pr-scan.sh!",
        // Structural destructive-operation scanner — invoked by policy-checks.sh.
        "scripts/check-destructive-operations.mjs!",
        // Agent-rules gate (route exports / t() coverage / sitemap sync) —
        // invoked by policy-checks.sh, not statically imported.
        "scripts/check-agent-rules.ts!",
        // Child Vitest config — passed dynamically to the I/O-guard fixture test.
        "scripts/vitest-test-io-guard-fixture.config.ts!"
      ],
      "ignoreBinaries": [
        // Global local-dev CLI. Intentionally not listed in package.json.
        "portless"
      ],
      "ignoreUnresolved": [
        // False positive: scripts/theme-apply.ts passes this as the `shadcn -c`
        // config path, not as a command or an import. knip <=6.26 classified it
        // as a binary (it lived in `ignoreBinaries`); 6.27 reclassified it as an
        // unresolved import, so the suppression moved here with it.
        "apps/web"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.tsx!",
        "src/hooks/*.ts!",
        "src/stores/*.ts!",
        // Documented overflow primitive (patterns/design-system.md). Not yet
        // imported from a route; deleting it would strip the recipe the docs
        // point at.
        "src/components/wide-content.tsx!"
      ],
      "ignoreDependencies": [
        // Imported only via PostCSS/Tailwind CSS pipeline, not statically.
        "tailwindcss",
        "postcss",
        // Consumed indirectly via `@orpc/client` + `createORPCClient`.
        "@orpc/server",
        // Toast primitive re-exported from @starter/ui.
        "sileo",
        // Optional peer of h3 2.x (pulled by TanStack Start); pinned here so the
        // SSR/oRPC stack binds crossws 0.4.x instead of the 0.3.x h3 1.x dedupes
        // to. No static import in source — it's a build/runtime transitive.
        "crossws"
      ]
    },
    "apps/server": {
      // better-auth is consumed via @starter/auth; declared directly so the
      // native binary / auth handler graph stays in this app's deploy image.
      "ignoreDependencies": ["better-auth"]
    },
    "apps/worker": {},
    "apps/native": {
      "entry": ["app/**/*.tsx!", "components/**/*.tsx!", "contexts/**/*.tsx!", "utils/**/*.ts!"],
      "ignoreDependencies": [
        // Expo app config probes this optional package even though this
        // managed template does not import it directly.
        "expo-updates"
      ]
    },
    "packages/ui": {
      "entry": ["src/components/**/*.tsx", "src/styles/**/*.css"]
    },
    "packages/api": {
      "ignoreDependencies": ["@orpc/client", "@orpc/openapi", "@orpc/zod"]
    },
    "packages/db": {
      "ignoreDependencies": ["@prisma/client", "pg", "zod"]
    },
    "packages/db-applier": {
      // Source-less by design: this member exists only so Dockerfile.db-applier
      // can `pnpm deploy` a lockfile-pinned closure of the tools the image runs
      // (prisma db push; dotenv, loaded by packages/db/prisma.config.ts; and the
      // S3 backup helpers' @aws-sdk/client-s3). Nothing here imports them, so
      // knip can't trace the usage — declare it. See Dockerfile.db-applier.
      // apply-schema.mjs resolves pg from this flattened production closure.
      "ignoreDependencies": ["prisma", "dotenv", "@aws-sdk/client-s3", "pg"]
    },
    "packages/auth": {
      "ignoreDependencies": ["zod"]
    }
  }
}
