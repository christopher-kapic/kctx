dist
**/dist
build
**/build
coverage
**/coverage
packages/db/prisma/generated

# Local dumps and app notes (notes/ is committed after onboarding; it must
# still stay out of the image so a filled-in access matrix cannot land in the
# build cache).
backups
**/backups
notes
**/notes

