# =============================================================================
# GENERATED FROM scripts/lib/env-manifest.ts — DO NOT EDIT BY HAND.
# Add or change a variable in that manifest, then run `pnpm env:sync`.
#
# This is the single canonical .env location — loaded by every package.
# Copy to .env and fill in real values: cp .env.example .env
# Do NOT create per-app .env files (e.g. apps/server/.env).
#
# For a PRODUCTION environment, don't fill this in by hand — run
# `pnpm generate:secrets`. It generates the random values, prompts only for
# what it can't know, skips whatever your deploy platform injects, and
# validates the result before printing it.
#
# Server vs worker: the env package is split. The BullMQ worker validates
# only the worker-safe (shared) surface — DATABASE_URL, REDIS_URL,
# NODE_ENV, the S3_* block, SMTP, and the translation
# keys. The server-only vars (BETTER_AUTH_*, CORS_ORIGIN, SSO_*,
# SIGNUP_ENABLED, VAPID_*, ADMIN_EMAILS, RATE_LIMIT_*, IMAGE_*,
# ASSET_UPLOAD_MAX_BYTES, SSR_CACHE_TTL_SECONDS) are NOT required by a
# worker-only deployment. For local dev you set everything in one file
# regardless; the split only matters when server and worker run on
# separate hosts. Sections are tagged [shared] or [server-only].
#
# Structure: core/required vars first, then optional feature blocks
# (shipped commented out — uncommenting a block is what turns the feature
# on), then one clearly-marked Advanced tuning section of one-off knobs,
# each commented with its working default. The FULL variable catalog —
# including one-shot restore/db-applier knobs that must stay unset on
# normal services — lives in scripts/lib/env-manifest.ts.
#
# NOTE: There is no auth-bypass mode. To exercise the real signup →
# email-verification → 2FA flow locally, use `pnpm dev:docker` — it ships
# an in-stack mailpit SMTP sink that captures verification email offline
# with zero credentials. See patterns/agent-ui-testing.md.
# =============================================================================

# --- Datastores — [shared] (server + worker) -------------------------------

# e.g. postgresql://user:password@host:5432/dbname — or leave blank to omit and set it on the platform
DATABASE_URL=postgresql://postgres:password@localhost:5432/starter
# e.g. redis://default:password@host:6379 (BullMQ + rate limiting) — or leave blank to omit and set it on the platform
REDIS_URL=redis://localhost:6379

# --- Runtime + schema sync — [shared] --------------------------------------
# APPLY_SCHEMA gates whether `prisma db push` runs at container start, and
# how aggressively. Set it to `safe` on EXACTLY ONE image (the schema
# leader) for a schema-changing deploy, then flip it back to `off`.
# dangerous additionally requires a target/fingerprint-bound
# APPLY_SCHEMA_CONFIRM. Full contract: infra-notes.md § The APPLY_SCHEMA contract.

# Set to `production` on every deployed environment. Several env guards
# escalate from a warning to a hard boot failure when this is `production`
# — that is intentional, do not weaken it to silence a startup error.
# Allowed: production | development | test
# NODE_ENV=production

# off | safe | dangerous. Read by scripts/docker-entrypoint.sh and
# scripts/db-applier.sh, not by the Zod env schemas. Keep this `off`
# for a normal deploy. dangerous requires APPLY_SCHEMA_CONFIRM.
# Allowed: off | safe | dangerous
# APPLY_SCHEMA=off

# [server-only] embedded runs background jobs in the app (default).
# Set external only when deploying a dedicated worker with the same Redis/database.
# External mode never silently falls back; /ready fails if consumers disappear.
# WORKER_MODE=embedded

# --- Database backups — [shared] -------------------------------------------
# Logical pg_dump backups uploaded to a private bucket. Production
# requires a dedicated BACKUP_S3_ACCESS_KEY_ID (not the app upload key),
# limited to GetObject, PutObject, and AbortMultipartUpload on the backup bucket. The freshness
# worker should use a distinct ListBucket-only monitor credential, not the
# dump-writer key.
# The db-applier image runs scheduled backups (BACKUP_CRON) and optional
# pre-apply dumps before APPLY_SCHEMA. Restore runs on the db-applier
# image only (RESTORE_BACKUP_S3_KEY + RESTORE_CONFIRM). See
# patterns/backup-and-restore.md.
#
# Disabled by default — uncomment to enable.

# Master switch for logical pg_dump backups. When false, scheduled and
# manual backup runs log a warning and exit without dumping.
# Allowed: true | false
# BACKUP_ENABLED=true
# Private bucket for pg_dump custom-format dumps. Prefer a dedicated bucket, not the app-assets bucket.
# BACKUP_S3_BUCKET=
# Required for dump writers. Must be a distinct GetObject/PutObject/AbortMultipartUpload key — never S3_ACCESS_KEY_ID.
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# ListBucket-only key for the worker freshness check; never reuse the dump read/write key.
# BACKUP_MONITOR_S3_ACCESS_KEY_ID=
# BACKUP_MONITOR_S3_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; a real region for AWS S3
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=

# --- Auth — [server-only] --------------------------------------------------

# REQUIRED, minimum 32 characters. The env validator rejects weak and
# placeholder values in production. Rotating this invalidates every
# existing session — generate once per environment and keep it stable.
#
# For LOCAL dev this is filled in for you by `pnpm run setup`; to mint one
# by hand use `pnpm generate:secret` and paste it below. For a PRODUCTION
# environment prefer `pnpm generate:secrets`, which generates this along
# with the rest of the block and validates the result.
BETTER_AUTH_SECRET=
# Origin only — no path, query, hash, or credentials. e.g. https://app.example.com
BETTER_AUTH_URL=https://starter.localhost

# Optional. Set ONLY when the browser app runs on a different origin than
# the API (raw web dev, Expo web, split-origin deploys). Leave unset for
# the default same-origin flow. No path, query, or hash.
# CORS_ORIGIN=https://app.example.com

# --- Admin + signup — [server-only] ----------------------------------------

# These accounts get admin privileges. Emails are trimmed and lowercased. Bootstrap-only: after provisioning, admins persist in the database and this list can be cleared. An empty list with SIGNUP_ENABLED=false (the default) only warns at boot — on a fresh install with no admin yet, nobody can become admin.
# ADMIN_EMAILS=admin@example.com,other@example.com

# DISABLED by default: account creation is rejected and the signup form is
# hidden — the safe default for internal tools. Set `true` for a
# customer-facing app, which also REQUIRES SMTP below (email verification
# is enforced on signup and the server refuses to boot without it).
# SIGNUP_ENABLED=false

# --- Email (SMTP) — [shared] -----------------------------------------------
# REQUIRED if SIGNUP_ENABLED=true — Better-Auth enforces email verification
# on signup, and the server refuses to boot in production without it.
# Local dev: `pnpm dev:services` starts a mailpit sink and `pnpm run setup`
#   fills these three lines automatically; read captured mail at
#   http://localhost:8025
#
# Disabled by default — uncomment to enable.

# e.g. smtp.resend.com, smtp.postmarkapp.com, email-smtp.us-east-1.amazonaws.com
# SMTP_HOST=localhost
# 587 for STARTTLS (most providers), 465 for implicit TLS, 1025 for a local mailpit sink
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# e.g. "App Name <no-reply@yourdomain.com>". Required whenever SMTP_HOST is set.
# SMTP_FROM=noreply@example.com

# --- SSO / enterprise login — [server-only] --------------------------------
# Optional. FORCE_SSO=true in production requires SSO_ENABLED plus all
# three SSO_CLIENT_ID / SSO_CLIENT_SECRET / SSO_ISSUER values, or the
# server throws at boot.
#
# Disabled by default — uncomment to enable.

# SSO_ENABLED=true
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# e.g. https://your-org.okta.com
# SSO_ISSUER=https://your-org.okta.com
# e.g. "Okta", "Entra ID", "Google Workspace"
# SSO_PROVIDER_NAME=Okta

# --- Web Push (VAPID) — [server-only] --------------------------------------
# Optional — the app runs fine without these. Set ALL THREE or none.
# The keypair is generated for you by `pnpm generate:secrets`; you supply
# VAPID_SUBJECT, a real mailto: or https: URL push services use to reach
# YOU about delivery problems. See patterns/removable/push.md.
#
# Disabled by default — uncomment to enable.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A mailto: or https: URL push services use to contact YOU about delivery problems. Use a real, monitored address.
# VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Asset storage (S3-compatible) — [shared] ------------------------------
# Optional. With S3_BUCKET unset, /api/assets/* and /api/images/* return
# 503 and the rest of the app boots. Works with AWS S3,
# Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces. See
# patterns/assets.md.
#
# Disabled by default — uncomment to enable.

# Accepts `bucket` or `bucket/prefix`. With a prefix, all objects live
# under `prefix/` and LISTs + cleanup sweeps are scoped to it — several
# dev apps can share one bucket, one prefix each. See patterns/assets.md.
# S3_BUCKET=
# "auto" for Cloudflare R2; a real region (e.g. us-east-1) for AWS S3
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Include the scheme. Required for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
# S3_ENDPOINT=

# MinIO and some self-hosted providers need path-style URLs
# (https://endpoint/bucket/key). The default works for AWS and R2.
# S3_FORCE_PATH_STYLE=false

# --- Translation provider — [shared] ---------------------------------------
# Used by `pnpm i18n:translate`.
# The app boots without these; the worker throws on the first job if the
# chosen provider's key is missing. Default provider is `openrouter` with
# `anthropic/claude-haiku-4-5` (~$0.05 for a full UI bundle). See patterns/i18n.md.
#
# Disabled by default — uncomment to enable.

# Allowed: openrouter | anthropic
# TRANSLATION_PROVIDER=openrouter
# Required when TRANSLATION_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# Required when TRANSLATION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Durable agentic chat — [shared] ---------------------------------------
# Optional tuning for the durable chat runtime (packages/agent-runtime +
# the BullMQ chat-run worker). Requires the worker and an OpenRouter key —
# chat deliberately reuses OPENROUTER_API_KEY from the translation group
# above rather than declaring a second provider secret. Every value has a
# working default; override only to tune. See patterns/add-ins/chat.md.

# Master switch for the chat feature — set to "true" to turn it on. Chat needs this AND OPENROUTER_API_KEY; with either missing the procedures return 503 and the nav entry disappears. Off by default because OPENROUTER_API_KEY is shared with `pnpm i18n:translate`, so a key configured for translations must not silently buy a paid tool-calling loop for every signed-in user.
# CHAT_ENABLED=false
# OpenRouter model id for the chat agent loop. Sonnet by default — a tool-calling loop degrades sharply on a small model.
# CHAT_MODEL=anthropic/claude-sonnet-4-5

# --- Advanced tuning -------------------------------------------------------
# One-off tuning knobs, grouped by feature. Every value has a working
# default shown on its line — uncomment and change ONLY the one you need.
# Rate-limit budgets rescale their whole limiter family coherently
# (multiplier = provided / reference); tighter is not safer — see
# patterns/rate-limiting.md. Deeper one-shot knobs (restore confirmations,
# db-applier modes) are deliberately absent from this file;
# the full catalog lives in scripts/lib/env-manifest.ts.

# === Datastores — [shared] (server + worker) ===

# Max connections in this process's Postgres pool (node-postgres `max`).
# Default 10 matches the driver default — raise it only against the
# database's connection budget, since every server/worker replica holds its own pool.
# Full pooler note: patterns/schema-guidelines.md § Connection pool size and transaction-mode poolers.
# DATABASE_POOL_MAX=10

# === Auth — [server-only] ===

# Number of reverse-proxy hops in front of the app, for deriving the real
# client IP used as the anonymous rate-limit key. LEAVE UNSET — the default
# auto-detects a client behind a private-network proxy (e.g. Dokploy/nginx)
# and keys on the socket peer otherwise. Set it only
# when a proxy in front of the app has a PUBLIC IP (e.g. Cloudflare): the
# exact hop count. 0 disables X-Forwarded-For entirely.
# TRUST_PROXY_HOPS=1

# === SSO / enterprise login — [server-only] ===

# true disables password login entirely. In production this requires
# SSO_ENABLED plus all three SSO credentials or the server throws at boot.
# FORCE_SSO=false

# === Durable agentic chat — [shared] ===
# Optional tuning for the durable chat runtime (packages/agent-runtime +
# the BullMQ chat-run worker). Requires the worker and an OpenRouter key —
# chat deliberately reuses OPENROUTER_API_KEY from the translation group
# above rather than declaring a second provider secret. Every value has a
# working default; override only to tune. See patterns/add-ins/chat.md.

# Max model dispatches per user turn. Each tool call costs one. Default 100 so explore/tool-heavy turns can finish; CHAT_RUN_TIMEOUT_MS is the hard wall-clock bound. Exhaustion stops as `max-iterations` (explore force-final synthesizes; chat marks ERROR/retryable).
# CHAT_MAX_ITERATIONS=100
# Wall-clock ceiling per user turn (ms), passed to the agent loop as `timeoutMs`. The only backstop against a hung provider request or tool call — iterations count completed dispatches only. Expiry stops the run as `timeout` and the session flips to ERROR (retryable).
# CHAT_RUN_TIMEOUT_MS=300000
# Grace period (ms) ON TOP OF CHAT_RUN_TIMEOUT_MS before the reap-stale-chat-runs cron hands a session stuck at RUNNING back as ERROR (retryable). Covers queue wait and the run's final writes; the threshold is the sum, never this value alone.
# CHAT_STALE_RUN_GRACE_MS=300000
# Optional directory the chat agent may investigate with confined glob/grep/read tools (flycockpit docs-answerer style). Leave blank to keep chat's default tools only. Temporary until per-package clonedPath scoping lands.
# CHAT_EXPLORE_ROOT=/data/repos/example-package
# Worker concurrency for the chat-run queue. Bound by the model provider's rate limit, not local CPU.
# CHAT_RUN_CONCURRENCY=4
# Redis TTL for oversized tool-result bodies the agent pages back with retrieve_tool_result. Default 6h.
# RESULT_STORE_TTL_SECONDS=21600

# === Rate limiting — [server-only] ===
# Five named budgets (AUTH, RPC, UPLOAD, EMAIL, CHAT), two knobs
# each. Each budget describes its family's reference member; every other
# limiter in the family scales with it at its designed ratio, so setting
# a budget re-tunes the whole family coherently. Defaults are sensible;
# tighter is not safer — if a surface 429s legitimate users, split the
# surface instead of shrinking a budget. See patterns/rate-limiting.md.

# Auth family reference: requests per IP per window on the general /api/auth/* surface (password reset, verification, session ops). Setting it rescales the whole fail-closed auth family at each member's designed ratio: credential 10, credential-burst 3/10s, signup 10/h, 2FA-OTP 3/15min.
# RATE_LIMIT_AUTH_POINTS=30
# Window (seconds) for the auth family reference. Scales every auth-family window AND block duration by the same factor.
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RPC family reference: requests per user (per IP signed out) per window on /rpc/*. /ready (60) and the SSR catch-all (300) scale with it. One batched request can carry up to ORPC_BATCH_MAX_SIZE procedures.
# RATE_LIMIT_RPC_POINTS=100
# Window (seconds) for the RPC family reference; scales /ready and SSR with it.
# RATE_LIMIT_RPC_WINDOW_SECONDS=60
# Upload family reference: /api/assets/* GETs per key per window. Images (300) scale with it — a page legitimately costs many media requests.
# RATE_LIMIT_UPLOAD_POINTS=200
# Window (seconds) for the upload family reference; scales the image bucket with it.
# RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
# Email family reference: mails per RECIPIENT per window on the anonymous send-mail endpoints (verification resend, password reset). Signup (6) and sign-in-triggered mails (10) scale with it. Keyed on the mailbox, so rotating IPs cannot flood one inbox. 0 disables the whole recipient family.
# RATE_LIMIT_EMAIL_POINTS=3
# Window (seconds) for the email family reference; scales all three recipient buckets with it.
# RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600
# Chat family reference: accepted chat turns (chat.send + chat.retry) per USER per window. One point buys one queued run worth up to CHAT_MAX_ITERATIONS paid model dispatches — a spend limiter that fails closed. Session creation (30) and the SSE stream (60) scale with it.
# RATE_LIMIT_CHAT_POINTS=20
# Window (seconds) for the chat family reference; scales the session-creation and stream buckets with it.
# RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# === Image proxy + transforms — [server-only] ===
# Optional tuning. IMAGE_PROXY_ALLOWED_HOSTS is an SSRF guard: empty means
# external URL proxying is disabled and only stored assets can be
# transformed. Set it only when you intentionally proxy remote images.

# IMAGE_PROXY_ALLOWED_HOSTS=cdn.example.com,images.partner.com
# IMAGE_TRANSFORM_MAX_INPUT_PIXELS=50000000

# === Upload + cache limits — [server-only] ===
# Optional tuning. Sensible defaults are built in.

# The server's own request body limit applies independently.
# ASSET_UPLOAD_MAX_BYTES=10485760

# In-memory SSR HTML cache for anonymous GETs of public routes. 0 disables
# it. Public content edits can take up to this long to appear live.
# See patterns/ssr-for-articles.md.
# SSR_CACHE_TTL_SECONDS=60
