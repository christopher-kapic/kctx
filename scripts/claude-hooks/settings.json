{
  "$comment": "Template for .claude/settings.json (installed by `pnpm run setup` / `pnpm claude:hooks:install`; .claude/ is gitignored). The PreToolUse hook blocks the AGENTS.md Dangerous Commands list at the tool boundary; the rules live in scripts/claude-hooks/pre-tool-use.mjs and are the authoritative gate. The permissions.deny list below is a coarse second layer covering the most destructive command prefixes. Re-running the installer merges anything missing into an existing settings file, and `pnpm doctor` warns when the installed copy has drifted from this one. Claude Code asks you to trust these hooks the first time — allow them. See patterns/claude-code-setup.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-tool-use.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(prisma migrate:*)",
      "Bash(pnpm prisma migrate:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(pnpm exec prisma migrate:*)",
      "Bash(prisma db drop:*)",
      "Bash(pnpm prisma db drop:*)",
      "Bash(npx prisma db drop:*)",
      "Bash(dropdb:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -d:*)",
      "Bash(git clean -x:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker-compose down -v:*)",
      "Bash(APPLY_SCHEMA=dangerous:*)",
      "Bash(export APPLY_SCHEMA=dangerous:*)",
      "Bash(ALLOW_NONLOCAL_DB_PUSH:*)",
      "Bash(export ALLOW_NONLOCAL_DB_PUSH:*)",
      "Bash(ALLOW_NONLOCAL_DB_PUSH_DANGEROUS:*)",
      "Bash(ALLOW_NONLOCAL_DB_SEED:*)",
      "Bash(ALLOW_NONLOCAL_DB_STUDIO:*)",
      "Bash(scripts/db-applier.sh apply:*)",
      "Bash(scripts/db-applier.sh restore:*)",
      "Bash(git checkout .:*)",
      "Bash(git checkout -- .:*)",
      "Edit(apps/web/src/routeTree.gen.ts)",
      "Write(apps/web/src/routeTree.gen.ts)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.cursorrules)",
      "Write(.cursorrules)",
      "Edit(.github/copilot-instructions.md)",
      "Write(.github/copilot-instructions.md)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)"
    ]
  }
}
